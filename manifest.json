{
  "manifest_version": 3,
  "name": "Reel Ad Blocker for Facebook",
  "version": "0.2.1",
  "description": "Hides and skips Facebook reels labelled Sponsored. Mark any other ad with one button and look-alikes are blocked too.",
  "homepage_url": "https://github.com/Carlsans/reel-ad-blocker",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*"
      ],
      "js": [
        "src/matcher.js",
        "src/page.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Reel Ad Blocker: manage rules",
    "default_popup": "manage.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "manage.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "reel-ad-blocker-cc4479d1@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
